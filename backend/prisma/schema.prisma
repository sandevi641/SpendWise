// Prisma Schema for SpendWise Personal Finance Web App
// Optimized for relational integrity, user data isolation, and financial accuracy.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  firstName          String
  lastName           String
  currency           String         @default("USD")
  monthlyIncomeGoal  Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  savingsGoals       SavingsGoal[]
  receiptScans       ReceiptScan[]

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  name         String
  type         String        @default("CHECKING") // CHECKING, SAVINGS, CREDIT_CARD, CASH, INVESTMENT
  balance      Float         @default(0)
  color        String        @default("#C27B38")
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id          String        @id @default(uuid())
  userId      String?       // Nullable for system global default categories
  name        String
  type        String        // INCOME, EXPENSE
  icon        String        @default("Tag")
  color       String        @default("#8B5E3C")
  budgetLimit Float?        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            String       @id @default(uuid())
  userId        String
  accountId     String
  categoryId    String
  amount        Float
  type          String       // INCOME, EXPENSE
  date          DateTime     @default(now())
  description   String
  paymentMethod String       @default("CARD") // CASH, CARD, BANK_TRANSFER, ONLINE, OTHER
  receiptUrl    String?
  tags          String?      // Comma-separated or JSON string of tags
  isRecurring   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receiptScans  ReceiptScan[]

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id              String    @id @default(uuid())
  userId          String
  categoryId      String?   // Optional: null represents total monthly budget
  month           Int       // 1-12
  year            Int       // e.g. 2026
  allocatedAmount Float
  alertThreshold  Float     @default(80.0) // Percentage (e.g. 80.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  category      String?   @default("General")
  status        String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  color         String    @default("#D97706")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

model ReceiptScan {
  id            String       @id @default(uuid())
  userId        String
  transactionId String?
  merchant      String?
  totalAmount   Float?
  date          DateTime?
  rawText       String?
  receiptUrl    String?
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("receipt_scans")
}
